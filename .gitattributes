# 统一换行符为 LF，避免 Windows/macOS/Linux 协作时的 CRLF 抖动
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.gz binary
*.zip binary
*.pdf binary

# 锁文件在 diff 中折叠，减少评审噪音
pnpm-lock.yaml linguist-generated=true
