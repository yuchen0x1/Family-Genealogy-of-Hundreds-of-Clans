# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
# 启动前重命名保存的历史构建缓存（纯生成物，勿入库；eslint.config.mjs 亦已排除）
/.next.old-*/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo

# local database data
/.pgdata/
*.log

# uploaded files (local storage, never served as static assets)
/.storage/
/public/uploads/*

# database backups (contain user data — never commit)
/backups/
/nginx/certs/*.pem

# test artifacts
/.vitest/
/test-results/
/playwright-report/
/coverage/
# reports/*.json 是交付的测试/安全/性能报告，保留入库

# 本地 AI 助手工作记忆（不入库）
/.workbuddy/

# 工具链产生的 0 字节临时文件（prisma generate / pnpm 供应链检查残留）
/_tmp_*

# 自主升级任务的持久化过程记录（不入库）
/.autonomous-upgrade/

# 截图脚本生成物（含本机路径，不入库）
/docs/images/readme/manifest.json
