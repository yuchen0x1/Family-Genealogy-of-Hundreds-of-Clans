// 中华寻根 · 百家族谱 —— 数据模型
// 设计原则：
// 1. 历史姓氏知识（surnames / historical_*）与用户真实家族数据（families / family_*）严格隔离；
//    同姓不自动合并，同名的历史人物与家族成员永不自动关联。
// 2. 每条历史资料必须挂接来源（HistoricalSource / SourceCitation）并标注可信度与审核状态。
// 3. 人物关系单独建模，明确类型、方向、核实状态、证据来源；血缘关系与婚姻/收养关系分开。
// 4. UUID 主键、外键完整性、软删除、时间戳、版本控制。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ============================================================
// 枚举
// ============================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ReviewStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  DISPUTED
}

/// 史料可信程度：明确记载 / 地方传说 / 研究推测
enum EvidenceLevel {
  DOCUMENTED
  TRADITION
  INFERRED
  UNVERIFIED
}

enum SourceType {
  OFFICIAL_HISTORY
  LOCAL_GAZETTEER
  ARCHIVE
  ACADEMIC
  GENEALOGY
  FOLK_MATERIAL
  OTHER
}

enum SourceCredibility {
  PRIMARY
  SECONDARY
  TERTIARY
  UNRATED
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum Visibility {
  PRIVATE
  FAMILY
  PUBLIC
}

enum SurnameCategory {
  SINGLE
  COMPOUND
  OTHER
}

enum DatePrecision {
  EXACT
  YEAR
  MONTH
  RANGE
  APPROXIMATE
  TEXT_ONLY
  UNKNOWN
}

/// 关系类型。方向约定：
/// PARENT_CHILD: from=父母, to=子女（父子关系方向不可逆）
/// SPOUSE: 对称关系，from/to 无方向语义
/// SIBLING: 对称关系
/// ADOPTION: from=养父母, to=养子女
/// SUCCESSION: 过继/承祧，from=承继方家族长辈, to=过继人
/// GUARDIANSHIP: 抚养/监护，非血缘
/// CROSS_FAMILY_LINK: 跨家族关联（必须双方确认，不得自动推断血缘）
enum RelationType {
  PARENT_CHILD
  SPOUSE
  SIBLING
  ADOPTION
  SUCCESSION
  GUARDIANSHIP
  CROSS_FAMILY_LINK
}

/// 关系子类型，用于区分生物学血缘与姻亲/拟制血亲
enum RelationSubtype {
  BIOLOGICAL
  ADOPTIVE
  STEP
  FOSTER
  FULL
  HALF_PATERNAL
  HALF_MATERNAL
  MARRIAGE
  CONCUBINAGE
  UNKNOWN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  DISPUTED
  REJECTED
}

enum FamilyPermissionCode {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum CollaboratorStatus {
  PENDING
  ACTIVE
  REVOKED
  DECLINED
}

enum PlaceType {
  PROVINCE
  CITY
  COUNTY
  TOWNSHIP
  VILLAGE
  REGION
  SITE
}

enum DocumentCategory {
  OLD_GENEALOGY
  PHOTO
  HISTORICAL_DOCUMENT
  PDF
  TEXT
  AUDIO
  VIDEO
  OTHER
}

enum OcrStatus {
  NONE
  QUEUED
  PROCESSING
  DONE
  FAILED
}

enum PostType {
  SEEK_RELATIVE
  DISCUSSION
  ANNOUNCEMENT
  EVENT
  FAMILY_NEWS
  CORRECTION
}

enum PostStatus {
  DRAFT
  PUBLISHED
  PENDING_REVIEW
  HIDDEN
  REMOVED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportFormat {
  GEDCOM551
  GEDCOM70
  CSV
  JSON
}

enum ExportFormat {
  GEDCOM551
  GEDCOM70
  CSV
  JSON
  PDF
  PNG
  SVG
}

// ============================================================
// 用户体系
// ============================================================

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(255)
  passwordHash        String    @map("password_hash")
  status              UserStatus @default(ACTIVE)
  emailVerifiedAt     DateTime? @map("email_verified_at")
  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  profile             UserProfile?
  sessions            UserSession[]
  roles               UserRole[]
  permissions         UserPermission[]
  ownedFamilies       Family[]               @relation("FamilyOwner")
  collaborators       FamilyCollaborator[]
  sentInvitations     FamilyInvitation[]      @relation("InvitationInviter")
  membersCreated      FamilyMember[]         @relation("MemberCreator")
  relationshipsCreated FamilyRelationship[]  @relation("RelationshipCreator")
  documents           FamilyDocument[]       @relation("DocumentUploader")
  documentVersions    DocumentVersion[]      @relation("VersionCreator")
  posts               Post[]                 @relation("PostAuthor")
  comments            Comment[]              @relation("CommentAuthor")
  sentMessages        Message[]              @relation("MessageSender")
  receivedMessages    Message[]              @relation("MessageRecipient")
  notifications       Notification[]
  reports             Report[]               @relation("ReportReporter")
  handledReports      Report[]               @relation("ReportHandler")
  auditLogs           AuditLog[]             @relation("AuditActor")
  searchRecords       SearchRecord[]
  importJobs          ImportJob[]
  exportJobs          ExportJob[]
  versionsCreated     GenealogyVersion[]     @relation("GenealogyVersionCreator")
  sourcesEntered      HistoricalSource[]     @relation("SourceEnterer")
  citationsCreated    SourceCitation[]       @relation("CitationCreator")
  connectionRequests  ClanConnection[]       @relation("ConnectionRequester")
  connectionReceived  ClanConnection[]       @relation("ConnectionAddressee")
  updateJobs          UpdateJob[]            @relation("UpdateRequester")

  @@index([status, createdAt])
  @@map("users")
}

model UserProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  displayName     String   @map("display_name") @db.VarChar(100)
  avatarFileId    String?  @map("avatar_file_id") @db.Uuid
  bio             String?  @db.VarChar(1000)
  surname         String?  @db.VarChar(20)
  location        String?  @db.VarChar(200)
  /// 隐私设置 JSON：{ showEmail, showRealName, allowClanSearch, ... }
  privacySettings Json     @default("{}") @map("privacy_settings")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// 仅存储 token 的 SHA-256 摘要，原始 token 只存在于 HttpOnly Cookie
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  ipHash     String?   @map("ip_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([tokenHash])
  @@map("user_sessions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id             String @id @default(uuid()) @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code") @db.VarChar(100)

  role           Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionCode])
  @@map("role_permissions")
}

model UserPermission {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  permissionCode String    @map("permission_code") @db.VarChar(100)
  grantedBy      String?   @map("granted_by") @db.Uuid
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionCode])
  @@map("user_permissions")
}

// ============================================================
// 姓氏知识库（历史资料，与用户家族数据隔离）
// ============================================================

model Surname {
  id            String          @id @default(uuid()) @db.Uuid
  name          String          @unique @db.VarChar(20)
  pinyin        String          @db.VarChar(100)
  /// 全拼（无音调）+ 首字母，供拼音检索，如 "wang,w"
  pinyinKeys    String[]        @default([]) @map("pinyin_keys")
  traditional   String?         @db.VarChar(20)
  category      SurnameCategory @default(SINGLE)
  popularityRank Int?           @map("popularity_rank")
  originSummary String?         @map("origin_summary") @db.VarChar(2000)
  /// 资料整体可信程度（不得将传说写成史实）
  credibility   EvidenceLevel   @default(UNVERIFIED)
  reviewStatus  ReviewStatus    @default(DRAFT) @map("review_status")
  viewCount     Int             @default(0) @map("view_count")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  origins       SurnameOrigin[]
  variants      SurnameVariant[]
  hallNames     SurnameHallName[]
  commanderies  SurnameCommandery[]
  figures       HistoricalFigure[]
  events        HistoricalEvent[]
  migrations    MigrationRecord[]
  families      Family[]             @relation("SurnameFamilies")
  posts         Post[]

  @@index([pinyin])
  @@index([popularityRank])
  @@index([reviewStatus])
  @@map("surnames")
}

model SurnameOrigin {
  id            String           @id @default(uuid()) @db.Uuid
  surnameId     String           @map("surname_id") @db.Uuid
  title         String           @db.VarChar(200)
  content       String
  era           String?          @db.VarChar(100)
  evidenceLevel EvidenceLevel    @default(UNVERIFIED) @map("evidence_level")
  reviewStatus  ReviewStatus     @default(PENDING) @map("review_status")
  sourceId      String?          @map("source_id") @db.Uuid
  createdBy     String?          @map("created_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")

  surname       Surname          @relation(fields: [surnameId], references: [id], onDelete: Cascade)
  source        HistoricalSource? @relation("OriginSource", fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([surnameId, reviewStatus])
  @@map("surname_origins")
}

model SurnameVariant {
  id         String   @id @default(uuid()) @db.Uuid
  surnameId  String   @map("surname_id") @db.Uuid
  variant    String   @db.VarChar(50)
  variantType String  @default("异体字") @map("variant_type") @db.VarChar(50)
  note       String?  @db.VarChar(500)
  sourceId   String?  @map("source_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  surname    Surname  @relation(fields: [surnameId], references: [id], onDelete: Cascade)

  @@unique([surnameId, variant])
  @@index([variant])
  @@map("surname_variants")
}

model SurnameHallName {
  id          String   @id @default(uuid()) @db.Uuid
  surnameId   String   @map("surname_id") @db.Uuid
  name        String   @db.VarChar(100)
  origin      String?  @db.VarChar(1000)
  location    String?  @db.VarChar(200)
  sourceId    String?  @map("source_id") @db.Uuid
  reviewStatus ReviewStatus @default(PENDING) @map("review_status")
  createdAt   DateTime @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  surname     Surname  @relation(fields: [surnameId], references: [id], onDelete: Cascade)

  @@unique([surnameId, name])
  @@map("surname_hall_names")
}

model SurnameCommandery {
  id              String   @id @default(uuid()) @db.Uuid
  surnameId       String   @map("surname_id") @db.Uuid
  name            String   @db.VarChar(100)
  historicalPlace String?  @map("historical_place") @db.VarChar(200)
  modernPlace     String?  @map("modern_place") @db.VarChar(200)
  sourceId        String?  @map("source_id") @db.Uuid
  reviewStatus    ReviewStatus @default(PENDING) @map("review_status")
  createdAt       DateTime @default(now()) @map("created_at")
  deletedAt       DateTime? @map("deleted_at")

  surname         Surname  @relation(fields: [surnameId], references: [id], onDelete: Cascade)

  @@unique([surnameId, name])
  @@map("surname_commanderies")
}

model HistoricalFigure {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @db.VarChar(100)
  surnameId      String?       @map("surname_id") @db.Uuid
  courtesyName   String?       @map("courtesy_name") @db.VarChar(100)
  dynasty        String?       @db.VarChar(100)
  birthYear      Int?          @map("birth_year")
  deathYear      Int?          @map("death_year")
  birthplace     String?       @db.VarChar(200)
  biography      String?
  achievements   String?
  evidenceLevel  EvidenceLevel @default(UNVERIFIED) @map("evidence_level")
  reviewStatus   ReviewStatus  @default(PENDING) @map("review_status")
  sourceId       String?       @map("source_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  surname        Surname?      @relation(fields: [surnameId], references: [id], onDelete: SetNull)
  source         HistoricalSource? @relation("FigureSource", fields: [sourceId], references: [id], onDelete: SetNull)
  activityPlaces HistoricalFigurePlace[]

  @@index([surnameId, dynasty])
  @@index([name])
  @@map("historical_figures")
}

model HistoricalEvent {
  id             String        @id @default(uuid()) @db.Uuid
  title          String        @db.VarChar(300)
  dynasty        String?       @db.VarChar(100)
  yearText       String?       @map("year_text") @db.VarChar(100)
  yearValue      Int?          @map("year_value")
  description    String?
  surnameId      String?       @map("surname_id") @db.Uuid
  placeId        String?       @map("place_id") @db.Uuid
  evidenceLevel  EvidenceLevel @default(UNVERIFIED) @map("evidence_level")
  reviewStatus   ReviewStatus  @default(PENDING) @map("review_status")
  sourceId       String?       @map("source_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  deletedAt      DateTime?     @map("deleted_at")

  surname        Surname?      @relation(fields: [surnameId], references: [id], onDelete: SetNull)
  place          HistoricalPlace? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([surnameId, yearValue])
  @@map("historical_events")
}

// ============================================================
// 历史寻根 / 地名 / 迁徙 / 来源
// ============================================================

model HistoricalPlace {
  id             String        @id @default(uuid()) @db.Uuid
  historicalName String        @map("historical_name") @db.VarChar(200)
  modernName     String?       @map("modern_name") @db.VarChar(200)
  placeType      PlaceType     @default(SITE) @map("place_type")
  divisionId     String?       @map("division_id") @db.Uuid
  longitude      Decimal?      @db.Decimal(10, 6)
  latitude       Decimal?      @db.Decimal(10, 6)
  evidenceLevel  EvidenceLevel @default(UNVERIFIED) @map("evidence_level")
  reviewStatus   ReviewStatus  @default(PENDING) @map("review_status")
  sourceId       String?       @map("source_id") @db.Uuid
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  division       AdministrativeDivision? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  aliases        PlaceAlias[]
  migrationsFrom MigrationRecord[] @relation("MigrationFrom")
  migrationsTo   MigrationRecord[] @relation("MigrationTo")
  figurePlaces   HistoricalFigurePlace[]
  familyEvents   FamilyEvent[]
  events         HistoricalEvent[]
  memberBirthPlaces FamilyMember[] @relation("MemberBirthPlace")
  memberAncestralHomes FamilyMember[] @relation("MemberAncestralHome")

  @@index([historicalName])
  @@index([modernName])
  @@map("historical_places")
}

model PlaceAlias {
  id        String   @id @default(uuid()) @db.Uuid
  placeId   String   @map("place_id") @db.Uuid
  alias     String   @db.VarChar(200)
  era       String?  @db.VarChar(100)
  source    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  place     HistoricalPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, alias])
  @@index([alias])
  @@map("place_aliases")
}

model AdministrativeDivision {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(200)
  code       String?  @db.VarChar(30)
  level      PlaceType
  parentId   String?  @map("parent_id") @db.Uuid
  dynasty    String?  @db.VarChar(100)
  periodStart Int?    @map("period_start")
  periodEnd   Int?    @map("period_end")
  createdAt  DateTime @default(now()) @map("created_at")

  parent     AdministrativeDivision?  @relation("DivisionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   AdministrativeDivision[] @relation("DivisionTree")
  places     HistoricalPlace[]

  @@index([name, level])
  @@index([parentId])
  @@map("administrative_divisions")
}

model MigrationRecord {
  id             String        @id @default(uuid()) @db.Uuid
  surnameId      String?       @map("surname_id") @db.Uuid
  familyId       String?       @map("family_id") @db.Uuid
  fromPlaceId    String?       @map("from_place_id") @db.Uuid
  toPlaceId      String?       @map("to_place_id") @db.Uuid
  dynasty        String?       @db.VarChar(100)
  startYear      Int?          @map("start_year")
  endYear        Int?          @map("end_year")
  reason         String?       @db.VarChar(500)
  narrative      String?
  /// 途经点坐标 [{"lng":...,"lat":...,"name":"..."}]，不得凭空生成
  routePoints    Json          @default("[]") @map("route_points")
  /// 史料明确记载 / 地方传说 / 研究推测
  evidenceLevel  EvidenceLevel @default(UNVERIFIED) @map("evidence_level")
  reviewStatus   ReviewStatus  @default(PENDING) @map("review_status")
  verification   VerificationStatus @default(UNVERIFIED)
  sourceId       String?       @map("source_id") @db.Uuid
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  surname        Surname?      @relation(fields: [surnameId], references: [id], onDelete: SetNull)
  family         Family?       @relation(fields: [familyId], references: [id], onDelete: SetNull)
  fromPlace      HistoricalPlace? @relation("MigrationFrom", fields: [fromPlaceId], references: [id], onDelete: SetNull)
  toPlace        HistoricalPlace? @relation("MigrationTo", fields: [toPlaceId], references: [id], onDelete: SetNull)
  source         HistoricalSource? @relation("MigrationSource", fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([surnameId, startYear])
  @@index([familyId, startYear])
  @@map("migration_records")
}

model HistoricalSource {
  id            String            @id @default(uuid()) @db.Uuid
  title         String            @db.VarChar(300)
  author        String?           @db.VarChar(200)
  edition       String?           @db.VarChar(200)
  publisher     String?           @db.VarChar(200)
  publishYear   Int?              @map("publish_year")
  volumeOrPage  String?           @map("volume_or_page") @db.VarChar(200)
  originalQuote String?           @map("original_quote")
  digitalUrl    String?           @map("digital_url") @db.VarChar(1000)
  sourceType    SourceType        @default(OTHER) @map("source_type")
  credibility   SourceCredibility @default(UNRATED)
  reviewStatus  ReviewStatus      @default(PENDING) @map("review_status")
  enteredById   String?           @map("entered_by_id") @db.Uuid
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  enteredBy     User?             @relation("SourceEnterer", fields: [enteredById], references: [id], onDelete: SetNull)
  origins       SurnameOrigin[]   @relation("OriginSource")
  figures       HistoricalFigure[] @relation("FigureSource")
  migrations    MigrationRecord[] @relation("MigrationSource")
  citations     SourceCitation[]

  @@index([title])
  @@index([reviewStatus, sourceType])
  @@map("historical_sources")
}

/// 通用引用表：把「来源」挂到任意实体（entity_type + entity_id）。
/// PostgreSQL 无法对多态外键做物理约束，故由应用层保证实体存在。
model SourceCitation {
  id              String   @id @default(uuid()) @db.Uuid
  sourceId        String   @map("source_id") @db.Uuid
  entityType      String   @map("entity_type") @db.VarChar(50)
  entityId        String   @map("entity_id") @db.Uuid
  pageOrVolume    String?  @map("page_or_volume") @db.VarChar(200)
  quote           String?
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  // 说明：entity_type + entity_id 为多态引用（PostgreSQL 无多态外键），
  // 由应用层保证目标实体存在，故此处不建立 Prisma relation。
  source          HistoricalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("CitationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("source_citations")
}

model HistoricalFigurePlace {
  id        String   @id @default(uuid()) @db.Uuid
  figureId  String   @map("figure_id") @db.Uuid
  placeId   String   @map("place_id") @db.Uuid
  activity  String?  @db.VarChar(200)
  sourceId  String?  @map("source_id") @db.Uuid

  figure    HistoricalFigure @relation(fields: [figureId], references: [id], onDelete: Cascade)
  place     HistoricalPlace  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([figureId, placeId, activity])
  @@map("historical_figure_places")
}

// ============================================================
// 家族族谱（用户真实数据）
// ============================================================

model Family {
  id             String      @id @default(uuid()) @db.Uuid
  name           String      @db.VarChar(200)
  surnameId      String?     @map("surname_id") @db.Uuid
  /// 冗余姓氏文本：允许族谱使用尚未收录进姓氏库的姓氏
  surnameText    String      @map("surname_text") @db.VarChar(20)
  founderName    String?     @map("founder_name") @db.VarChar(100)
  ancestralHome  String?     @map("ancestral_home") @db.VarChar(300)
  description    String?
  hallName       String?     @map("hall_name") @db.VarChar(100)
  /// 是否公开：默认私有，公开必须由有权限成员主动授权
  visibility     Visibility  @default(PRIVATE)
  ownerId        String      @map("owner_id") @db.Uuid
  coverFileId    String?     @map("cover_file_id") @db.Uuid
  avatarFileId   String?     @map("avatar_file_id") @db.Uuid
  /// 演示数据标记（公开演示族谱，非真实家族资料）
  isDemo         Boolean     @default(false) @map("is_demo")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  surname        Surname?    @relation("SurnameFamilies", fields: [surnameId], references: [id], onDelete: SetNull)
  owner          User        @relation("FamilyOwner", fields: [ownerId], references: [id])
  members        FamilyMember[]
  relationships  FamilyRelationship[]
  branches       FamilyBranch[]
  generations    FamilyGeneration[]
  generationPoems GenerationPoem[]
  events         FamilyEvent[]
  collaborators  FamilyCollaborator[]
  invitations    FamilyInvitation[]
  permissions    FamilyPermission[]
  versions       GenealogyVersion[]
  documents      FamilyDocument[]
  migrations     MigrationRecord[]
  posts          Post[]
  importJobs     ImportJob[]
  exportJobs     ExportJob[]
  connectionRequestsAsA ClanConnection[] @relation("ConnectionFamilyA")
  connectionRequestsAsB ClanConnection[] @relation("ConnectionFamilyB")

  @@index([ownerId])
  @@index([visibility, createdAt])
  @@index([surnameId])
  @@map("families")
}

model FamilyMember {
  id                  String        @id @default(uuid()) @db.Uuid
  familyId            String        @map("family_id") @db.Uuid
  /// 姓名与姓氏分列，支持复姓、少数民族姓名、同名人物
  surnameText         String        @map("surname_text") @db.VarChar(20)
  givenName           String        @map("given_name") @db.VarChar(100)
  courtesyName        String?       @map("courtesy_name") @db.VarChar(100)
  alias               String?       @db.VarChar(200)
  gender              Gender        @default(UNKNOWN)
  /// 日期用文本保存（支持农历、朝代纪年、模糊纪年），另存整数年份用于排序与时间轴
  birthDateText       String?       @map("birth_date_text") @db.VarChar(100)
  birthYear           Int?          @map("birth_year")
  birthPrecision      DatePrecision @default(UNKNOWN) @map("birth_precision")
  deathDateText       String?       @map("death_date_text") @db.VarChar(100)
  deathYear           Int?          @map("death_year")
  deathPrecision      DatePrecision @default(UNKNOWN) @map("death_precision")
  isLiving            Boolean       @default(true) @map("is_living")
  birthPlaceId        String?       @map("birth_place_id") @db.Uuid
  ancestralHomeId     String?       @map("ancestral_home_id") @db.Uuid
  biography           String?
  generationNumber    Int?          @map("generation_number")
  /// 字辈用字：需人工确认，禁止按名字自动推断
  generationChar      String?       @map("generation_char") @db.VarChar(10)
  generationConfirmed Boolean       @default(false) @map("generation_confirmed")
  branchId            String?       @map("branch_id") @db.Uuid
  avatarFileId        String?       @map("avatar_file_id") @db.Uuid
  /// 人物级隐私：在世人员默认 PRIVATE，禁止默认公开出生日期等敏感信息
  visibility          Visibility    @default(PRIVATE) @map("visibility")
  /// 敏感字段（联系方式、详细住址等）单独加密存储，不进入公开查询
  sensitiveDataEncrypted String?    @map("sensitive_data_encrypted")
  verification        VerificationStatus @default(UNVERIFIED)
  version             Int           @default(1)
  createdById         String?       @map("created_by_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")

  family              Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator             User?         @relation("MemberCreator", fields: [createdById], references: [id], onDelete: SetNull)
  branch              FamilyBranch? @relation("BranchMembers", fields: [branchId], references: [id], onDelete: SetNull)
  birthPlace          HistoricalPlace? @relation("MemberBirthPlace", fields: [birthPlaceId], references: [id], onDelete: SetNull)
  ancestralHome       HistoricalPlace? @relation("MemberAncestralHome", fields: [ancestralHomeId], references: [id], onDelete: SetNull)

  outgoingRelations   FamilyRelationship[] @relation("RelationFrom")
  incomingRelations   FamilyRelationship[] @relation("RelationTo")
  documentLinks       DocumentPersonLink[]
  branchRoots         FamilyBranch[]       @relation("BranchRoot")

  @@index([familyId, deletedAt])
  @@index([familyId, generationNumber])
  @@index([familyId, birthYear])
  @@index([givenName])
  @@map("family_members")
}

model FamilyRelationship {
  id             String             @id @default(uuid()) @db.Uuid
  familyId       String             @map("family_id") @db.Uuid
  fromPersonId   String             @map("from_person_id") @db.Uuid
  toPersonId     String             @map("to_person_id") @db.Uuid
  type           RelationType
  subtype        RelationSubtype    @default(BIOLOGICAL)
  /// 关系是否有方向：PARENT_CHILD/ADOPTION/SUCCESSION 有方向，SPOUSE/SIBLING 对称
  directional    Boolean            @default(true)
  /// 关系核实状态：未核实的关系不得参与亲属称谓自动计算
  verification   VerificationStatus @default(UNVERIFIED)
  /// 证据等级：明确记载 / 口述传说 / 推测
  evidenceLevel  EvidenceLevel      @default(UNVERIFIED) @map("evidence_level")
  startDateText  String?            @map("start_date_text") @db.VarChar(100)
  endDateText    String?            @map("end_date_text") @db.VarChar(100)
  /// 多次婚姻用 marriageOrder 区分，配合 start/endDate
  marriageOrder  Int?               @map("marriage_order")
  notes          String?
  sourceId       String?            @map("source_id") @db.Uuid
  documentId     String?            @map("document_id") @db.Uuid
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")

  family         Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  fromPerson     FamilyMember       @relation("RelationFrom", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPerson       FamilyMember       @relation("RelationTo", fields: [toPersonId], references: [id], onDelete: Cascade)
  creator        User?              @relation("RelationshipCreator", fields: [createdById], references: [id], onDelete: SetNull)
  document       FamilyDocument?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([fromPersonId, toPersonId, type, subtype, deletedAt])
  @@index([familyId, type, verification])
  @@index([fromPersonId, type])
  @@index([toPersonId, type])
  @@map("family_relationships")
}

model FamilyBranch {
  id          String    @id @default(uuid()) @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  name        String    @db.VarChar(200)
  parentId    String?   @map("parent_id") @db.Uuid
  rootPersonId String?  @map("root_person_id") @db.Uuid
  description String?
  color       String?   @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  parent      FamilyBranch?  @relation("BranchTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    FamilyBranch[] @relation("BranchTree")
  rootPerson  FamilyMember?  @relation("BranchRoot", fields: [rootPersonId], references: [id], onDelete: SetNull)
  members     FamilyMember[] @relation("BranchMembers")
  generationPoems GenerationPoem[]

  @@index([familyId, parentId])
  @@map("family_branches")
}

model FamilyGeneration {
  id                String   @id @default(uuid()) @db.Uuid
  familyId          String   @map("family_id") @db.Uuid
  generationNumber  Int      @map("generation_number")
  generationChar    String?  @map("generation_char") @db.VarChar(10)
  poemLine          String?  @map("poem_line") @db.VarChar(500)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  family            Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, generationNumber])
  @@map("family_generations")
}

model GenerationPoem {
  id             String   @id @default(uuid()) @db.Uuid
  familyId       String   @map("family_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  title          String   @db.VarChar(200)
  content        String
  /// 字辈逐字列表，顺序即世代顺序（由用户输入/审核，不从名字推断）
  characters     String[] @default([])
  sourceText     String?  @map("source_text") @db.VarChar(1000)
  reviewStatus   ReviewStatus @default(PENDING) @map("review_status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  family         Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  branch         FamilyBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([familyId, branchId])
  @@map("generation_poems")
}

model FamilyEvent {
  id          String    @id @default(uuid()) @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  title       String    @db.VarChar(300)
  eventType   String    @map("event_type") @db.VarChar(50)
  dateText    String?   @map("date_text") @db.VarChar(100)
  yearValue   Int?      @map("year_value")
  placeId     String?   @map("place_id") @db.Uuid
  description String?
  sourceId    String?   @map("source_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  place       HistoricalPlace? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([familyId, yearValue])
  @@map("family_events")
}

// ============================================================
// 家族协作 / 版本
// ============================================================

model FamilyCollaborator {
  id         String                @id @default(uuid()) @db.Uuid
  familyId   String                @map("family_id") @db.Uuid
  userId     String                @map("user_id") @db.Uuid
  permission FamilyPermissionCode  @default(VIEWER)
  status     CollaboratorStatus    @default(PENDING)
  invitedBy  String?               @map("invited_by") @db.Uuid
  acceptedAt DateTime?             @map("accepted_at")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  family     Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId, status])
  @@map("family_collaborators")
}

model FamilyInvitation {
  id          String               @id @default(uuid()) @db.Uuid
  familyId    String               @map("family_id") @db.Uuid
  email       String               @db.VarChar(255)
  tokenHash   String               @unique @map("token_hash") @db.VarChar(64)
  permission  FamilyPermissionCode @default(VIEWER)
  invitedById String               @map("invited_by_id") @db.Uuid
  expiresAt   DateTime             @map("expires_at")
  acceptedAt  DateTime?            @map("accepted_at")
  revokedAt   DateTime?            @map("revoked_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  family      Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedBy   User                 @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email, expiresAt])
  @@map("family_invitations")
}

model FamilyPermission {
  id          String   @id @default(uuid()) @db.Uuid
  familyId    String   @map("family_id") @db.Uuid
  subjectType String   @map("subject_type") @db.VarChar(20)
  subjectId   String   @map("subject_id") @db.Uuid
  resourceType String  @map("resource_type") @db.VarChar(50)
  resourceId  String?  @map("resource_id") @db.Uuid
  canRead     Boolean  @default(true) @map("can_read")
  canWrite    Boolean  @default(false) @map("can_write")
  createdAt   DateTime @default(now()) @map("created_at")

  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, subjectType, subjectId, resourceType, resourceId])
  @@map("family_permissions")
}

model GenealogyVersion {
  id             String   @id @default(uuid()) @db.Uuid
  familyId       String   @map("family_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  label          String?  @db.VarChar(200)
  changeSummary  String?  @map("change_summary")
  /// 完整快照 JSON（成员 + 关系 + 字辈 + 分支），用于版本对比与恢复
  snapshot       Json
  checksum       String   @db.VarChar(64)
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  family         Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy      User?    @relation("GenealogyVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([familyId, versionNumber])
  @@index([familyId, createdAt])
  @@map("genealogy_versions")
}

// ============================================================
// 档案资料
// ============================================================

model FamilyDocument {
  id             String           @id @default(uuid()) @db.Uuid
  familyId       String           @map("family_id") @db.Uuid
  title          String           @db.VarChar(300)
  category       DocumentCategory @default(OTHER)
  fileName       String           @map("file_name") @db.VarChar(300)
  storageKey     String           @map("storage_key") @db.VarChar(500)
  mimeType       String           @map("mime_type") @db.VarChar(150)
  sizeBytes      BigInt           @map("size_bytes")
  checksum       String           @db.VarChar(64)
  visibility     Visibility       @default(PRIVATE)
  description    String?
  /// OCR 文本仅供人工校对，绝不自动写入已核实关系
  ocrText        String?          @map("ocr_text")
  ocrStatus      OcrStatus        @default(NONE) @map("ocr_status")
  reviewStatus   ReviewStatus     @default(PENDING) @map("review_status")
  currentVersion Int              @default(1) @map("current_version")
  uploadedById   String?          @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  family         Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  uploader       User?            @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  versions       DocumentVersion[]
  personLinks    DocumentPersonLink[]
  sources        DocumentSource[]
  relationships  FamilyRelationship[]

  @@index([familyId, category, deletedAt])
  @@index([checksum])
  @@map("family_documents")
}

model DocumentVersion {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  versionNumber Int     @map("version_number")
  storageKey   String   @map("storage_key") @db.VarChar(500)
  sizeBytes    BigInt   @map("size_bytes")
  checksum     String   @db.VarChar(64)
  changeNote   String?  @map("change_note") @db.VarChar(500)
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  document     FamilyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator      User?          @relation("VersionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model DocumentPersonLink {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  personId     String   @map("person_id") @db.Uuid
  linkType     String   @default("MENTION") @map("link_type") @db.VarChar(50)
  verification VerificationStatus @default(UNVERIFIED)
  createdAt    DateTime @default(now()) @map("created_at")

  document     FamilyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  person       FamilyMember   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([documentId, personId, linkType])
  @@map("document_person_links")
}

model DocumentSource {
  id             String   @id @default(uuid()) @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  sourceId       String?  @map("source_id") @db.Uuid
  citationText   String?  @map("citation_text")
  verification   VerificationStatus @default(UNVERIFIED)
  createdAt      DateTime @default(now()) @map("created_at")

  document       FamilyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_sources")
}

// ============================================================
// 社区
// ============================================================

model Post {
  id          String     @id @default(uuid()) @db.Uuid
  authorId    String     @map("author_id") @db.Uuid
  familyId    String?    @map("family_id") @db.Uuid
  surnameId   String?    @map("surname_id") @db.Uuid
  type        PostType   @default(DISCUSSION)
  title       String     @db.VarChar(300)
  content     String
  tags        String[]   @default([])
  /// 寻亲信息中的祖籍、字辈线索等（结构化，便于检索）
  clues       Json       @default("{}")
  visibility  Visibility @default(PUBLIC)
  status      PostStatus @default(PUBLISHED)
  viewCount   Int        @default(0) @map("view_count")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  author      User       @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  family      Family?    @relation(fields: [familyId], references: [id], onDelete: SetNull)
  surname     Surname?   @relation(fields: [surnameId], references: [id], onDelete: SetNull)
  comments    Comment[]

  @@index([type, status, createdAt])
  @@index([status, createdAt])
  @@index([authorId])
  @@index([surnameId, type])
  @@index([familyId, createdAt])
  @@map("posts")
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  content   String    @db.VarChar(5000)
  status    PostStatus @default(PUBLISHED)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Comment[] @relation("CommentTree")

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("comments")
}

model Message {
  id                 String    @id @default(uuid()) @db.Uuid
  senderId           String    @map("sender_id") @db.Uuid
  recipientId        String    @map("recipient_id") @db.Uuid
  content            String    @db.VarChar(5000)
  readAt             DateTime? @map("read_at")
  deletedBySender    Boolean   @default(false) @map("deleted_by_sender")
  deletedByRecipient Boolean   @default(false) @map("deleted_by_recipient")
  createdAt          DateTime  @default(now()) @map("created_at")

  sender             User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient          User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([recipientId, readAt])
  @@map("messages")
}

/// 宗亲关联：同姓不等于同宗，必须双方确认 + 证据核验；
/// 未确认前不得展示为亲属关系，也不参与亲属称谓计算。
model ClanConnection {
  id                   String           @id @default(uuid()) @db.Uuid
  requesterId          String           @map("requester_id") @db.Uuid
  addresseeId          String           @map("addressee_id") @db.Uuid
  familyAId            String?          @map("family_a_id") @db.Uuid
  familyBId            String?          @map("family_b_id") @db.Uuid
  status               ConnectionStatus @default(PENDING)
  evidenceDocumentId   String?          @map("evidence_document_id") @db.Uuid
  evidenceNote         String?          @map("evidence_note")
  requesterConfirmedAt DateTime?        @map("requester_confirmed_at")
  addresseeConfirmedAt DateTime?        @map("addressee_confirmed_at")
  reviewedById         String?          @map("reviewed_by_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  requester            User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee            User             @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  familyA              Family?          @relation("ConnectionFamilyA", fields: [familyAId], references: [id], onDelete: SetNull)
  familyB              Family?          @relation("ConnectionFamilyB", fields: [familyBId], references: [id], onDelete: SetNull)

  @@unique([requesterId, addresseeId, familyAId, familyBId])
  @@index([status, createdAt])
  @@index([addresseeId, status])
  @@map("friendships")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(50)
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Report {
  id           String       @id @default(uuid()) @db.Uuid
  reporterId   String       @map("reporter_id") @db.Uuid
  targetType   String       @map("target_type") @db.VarChar(50)
  targetId     String       @map("target_id") @db.Uuid
  reason       String       @db.VarChar(1000)
  status       ReportStatus @default(OPEN)
  handledById  String?      @map("handled_by_id") @db.Uuid
  resolution   String?      @db.VarChar(1000)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  reporter     User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  handler      User?        @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId, targetType, targetId])
  @@map("reports")
}

